@page "/products"
@using ProductManagementApp.Business.Interfaces
@using ProductManagementApp.Models
@inject IProductService ProductService

<h1>Product Management</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

<div class="card p-3 mb-4">
    <h3>@(editMode ? "Edit Product" : "Add Product")</h3>

    <div class="mb-3">
        <label>Name</label>
        <input class="form-control" @bind="currentProduct.Name" />
    </div>

    <div class="mb-3">
        <label>Price</label>
        <input class="form-control" type="number" step="0.01"
               @bind="currentProduct.Price" />
    </div>

    <div class="mb-3">
        <label>Category</label>
        <input class="form-control" @bind="currentProduct.Category" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <textarea class="form-control"
                  @bind="currentProduct.Description"></textarea>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input"
               type="checkbox"
               @bind="currentProduct.IsActive" />
        <label class="form-check-label">
            Is Active
        </label>
    </div>

    <button class="btn btn-success" @onclick="SaveProduct">
        @(editMode ? "Update Product" : "Save Product")
    </button>

    @if (editMode)
    {
        <button class="btn btn-secondary ms-2" @onclick="CancelEdit">
            Cancel
        </button>
    }
</div>

<div class="card p-3 mb-4">
    <h3>Search Products</h3>

    <input class="form-control"
           placeholder="Search by name, category or description"
           @bind="searchKeyword" />

    <button class="btn btn-primary mt-2" @onclick="SearchProducts">
        Search
    </button>

    <button class="btn btn-secondary mt-2 ms-2" @onclick="LoadProducts">
        Show All
    </button>
</div>

@if (products.Count == 0)
{
    <div class="alert alert-info">
        No products found.
    </div>
}
else
{
    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Category</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Price</td>
                    <td>@product.Category</td>
                    <td>@product.Description</td>

                    <td>
                        @(product.IsActive ? "Active" : "Inactive")
                    </td>

                    <td>
                        <button class="btn btn-warning btn-sm"
                                @onclick="() => EditProduct(product.Id)">
                            Edit
                        </button>

                        <button class="btn btn-danger btn-sm ms-2"
                                @onclick="() => DeleteProduct(product.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>

    </table>
}

@code {

    private List<ProductModel> products = new();

    private ProductModel currentProduct = new()
    {
        IsActive = true
    };

    private string searchKeyword = string.Empty;

    private string errorMessage = string.Empty;

    private string successMessage = string.Empty;

    private bool editMode = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        ClearMessages();

        try
        {
            products = await ProductService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SearchProducts()
    {
        ClearMessages();

        try
        {
            products = await ProductService.SearchAsync(searchKeyword);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SaveProduct()
    {
        ClearMessages();

        try
        {
            if (editMode)
            {
                await ProductService.UpdateAsync(currentProduct);
                successMessage = "Product updated successfully.";
            }
            else
            {
                await ProductService.CreateAsync(currentProduct);
                successMessage = "Product added successfully.";
            }

            currentProduct = new ProductModel
            {
                IsActive = true
            };

            editMode = false;

            await LoadProducts();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task EditProduct(Guid id)
    {
        ClearMessages();

        try
        {
            var product = await ProductService.GetByIdAsync(id);

            if (product == null)
            {
                errorMessage = "Product not found.";
                return;
            }

            currentProduct = new ProductModel
            {
                Id = product.Id,
                Name = product.Name,
                Price = product.Price,
                Category = product.Category,
                Description = product.Description,
                IsActive = product.IsActive
            };

            editMode = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteProduct(Guid id)
    {
        ClearMessages();

        try
        {
            await ProductService.DeleteAsync(id);

            successMessage = "Product deleted successfully.";

            await LoadProducts();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        currentProduct = new ProductModel
        {
            IsActive = true
        };

        editMode = false;

        ClearMessages();
    }

    private void ClearMessages()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }
}